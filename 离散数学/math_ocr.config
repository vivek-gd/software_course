# File: math_ocr.config
# Tesseract 数学公式专用配置文件
# 版本 2.1 (支持多学科混合公式)

#######################
# 核心识别参数配置
#######################
[ocr_engine]
# 基础参数
tessedit_char_whitelist = 0123456789abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZαβγδεζηθικλμνξοπρστυφχψωΑΒΓΔΕΖΗΘΙΚΛΜΝΏΟΠΡΣΤΥΦΧΨΩ∈∉⊆⊂⊃∪∩∅∀∃¬∧∨→↔⇒⇔≡≈≠≤≥⌊⌋⌈⌉∫∬∭∮∂∇ℕℤℚℝℂ±∓×÷√∛∜∞∝⊕⊗⊙⊖∘∙⋆≅≃≍⊂⊃⊆⊇⊄⊅⊈⊉⊊⊋⋢⋣∈∉∋∌⊢⊣⊤⊥⋀⋁⋂⋃⋀⋁⨀⨁⨂⨄⨆⨉⨕⨚⨛⨜⨟⨠⨡

# 排版处理
textord_equation_detect 1        # 启用公式检测模式
textord_tabfind_vertical_text 0  # 禁用竖排文本检测
textord_space_size_is_variable 1  # 可变间距处理

# 字典配置
user_words_file math_lexicon.txt  # 学科术语词典
user_patterns_file math_patterns.txt  # 数学符号模式

#######################
# 符号映射规则
#######################
[symbol_normalization]
# Unicode标准化映射
∖ → \
∼ → ~
∗ → *
⋅ → ·
∶ → :
≈ → ≈
≠ → ≠
≤ → ≤
≥ → ≥
→ → →
⇒ → ⇒
∀ → ∀
∃ → ∃
∂ → ∂
∇ → ∇

# 手写体修正规则
ℜ → Re
ℑ → Im
℘ → wp
ℏ → hbar

#######################
# 学科特征参数
#######################
[discrete_math]
logic_symbol_weight = 1.5      # 逻辑符号权重
graph_detect_threshold = 0.8   # 图论结构检测阈值

[linear_algebra]
matrix_detection = 1           # 启用矩阵检测
matrix_bracket_match = 0.9     # 括号匹配置信度

[calculus]
integral_detection_level = 3    # 积分符号检测等级
differential_notation = 1       # 微分符号优先识别

#######################
# 输出格式化
#######################
[output_formatting]
latex_escape = 1                # 启用LaTeX转义
mathml_compatibility = 0        # 禁用MathML兼容模式
preserve_spacing = 0.7          # 间距保留系数

#######################
# 高级引擎参数
#######################
[advanced]
tessedit_ocr_engine_mode = 2     # LSTM引擎模式
tessedit_pageseg_mode = 6        # 单列公式布局
language_model_alpha = 0.85      # 语言模型权重
language_model_beta = 0.6        # 字符模型权重